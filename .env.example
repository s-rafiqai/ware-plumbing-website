# Ware Plumbing — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must NEVER be committed. This file (.env.example) is committed
# and documents which variables exist — keep the keys in sync, values empty.
#
# Nothing here is wired up yet; these are placeholders for the booking-system
# and contact-form integrations to be specified in a later phase.

# --- Site ---
# Canonical origin, no trailing slash. Used for metadata, sitemap, robots and
# structured data. Set this per environment (e.g. the Vercel deployment URL).
# NEXT_PUBLIC_SITE_URL=https://wareplumbing.com.au

# ===========================================================================
#  BOOKING FUNNEL (/book)  — everything below is OPTIONAL.
#  With nothing set, the funnel runs in fully-mocked DEMO mode (no accounts).
#  Flip these on one adapter at a time to go live (see README "Going live").
# ===========================================================================

# --- Demo flags ---
# Master switch. Unset/true = mocked demo. "false" = use real integrations.
# NEXT_PUBLIC_DEMO_MODE=true
# Payment step on/off (independent of demo mock). Default on.
# NEXT_PUBLIC_PAYMENT_ENABLED=true
# What the card step captures: deposit | prepay | card_on_file
# NEXT_PUBLIC_PAYMENT_MODE=deposit

# --- SMS verification: Twilio Verify (lib/integrations/real/sms.ts) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Payments: Stripe (lib/integrations/real/payment.ts) ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Job dispatch: Zapier → Fergus (lib/integrations/real/job.ts) ---
# The Zap's Catch Hook URL. Functional as soon as this is set.
# FERGUS_ZAP_WEBHOOK_URL=

# --- Store: Supabase (lib/integrations/real/store.ts) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form ---
# reCAPTCHA (contact form spam protection)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Where contact-form submissions are delivered
# CONTACT_FORM_ENDPOINT=
